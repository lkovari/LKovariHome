{
  "name": "lkovari-home",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "gitbuild": "ng build --configuration production --aot --base-href /LKovariHome/",
    "gitdeploy": "gh-pages -d dist",
    "test": "ng test",
    "lint": "ng lint",
    "migrate:angular-v22": "node scripts/run-v22-migrations-direct.cjs"
  },
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "pnpm": {
    "nodeLinker": "hoisted",
    "peerDependencyRules": {
      "allowedVersions": {
        "@angular/core": "22",
        "@angular/common": "22",
        "@angular/forms": "22",
        "@angular/router": "22",
        "@angular/cdk": "22",
        "@angular/platform-browser": "22",
        "@angular/platform-browser-dynamic": "22",
        "@angular/platform-server": "22"
      }
    },
    "overrides": {
      "@angular/fire>@angular/core": "$@angular/core",
      "@angular/fire>@angular/common": "$@angular/common",
      "@angular/fire>@angular/platform-browser": "$@angular/platform-browser",
      "@angular/fire>@angular/platform-browser-dynamic": "$@angular/platform-browser-dynamic",
      "@angular/fire>firebase": "$firebase",
      "rxfire>firebase": "$firebase"
    }
  },
  "dependencies": {
    "@angular/animations": "22.0.4",
    "@angular/cdk": "22.0.2",
    "@angular/common": "22.0.4",
    "@angular/compiler": "22.0.4",
    "@angular/core": "22.0.4",
    "@angular/fire": "20.0.1",
    "@angular/flex-layout": "^15.0.0-beta.42",
    "@angular/forms": "22.0.4",
    "@angular/material": "22.0.2",
    "@angular/platform-browser": "22.0.4",
    "@angular/platform-browser-dynamic": "22.0.4",
    "@angular/router": "22.0.4",
    "@fortawesome/angular-fontawesome": "^5.0.0",
    "@fortawesome/fontawesome-svg-core": "^6.7.1",
    "@fortawesome/free-brands-svg-icons": "^6.7.1",
    "@fortawesome/free-regular-svg-icons": "^6.7.1",
    "@fortawesome/free-solid-svg-icons": "^6.7.1",
    "@ngrx/signals": "22.0.0-rc.0",
    "@primeng/themes": "^21.0.4",
    "@primeuix/styled": "^0.7.4",
    "@primeuix/styles": "^1.2.5",
    "@primeuix/utils": "^0.6.2",
    "bootstrap": "^5.3.3",
    "firebase": "11.10.0",
    "font-awesome": "^4.7.0",
    "lodash": "^4.17.21",
    "ngx-clipboard": "^16.0.0",
    "ngx-cookie-service": "^22.0.0",
    "ngx-window-token": "^7.0.0",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.9",
    "rxjs": "~7.8.1",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.0.0",
    "@angular-eslint/eslint-plugin": "22.0.0",
    "@angular-eslint/eslint-plugin-template": "22.0.0",
    "@angular-eslint/schematics": "22.0.0",
    "@angular-eslint/template-parser": "22.0.0",
    "@angular/build": "22.0.4",
    "@angular/cli": "22.0.4",
    "@angular/compiler-cli": "22.0.4",
    "@eslint/js": "^9.28.0",
    "@schematics/angular": "22.0.4",
    "@vitest/coverage-v8": "^4.0.8",
    "angular-eslint": "22.0.0",
    "eslint": "^9.28.0",
    "gh-pages": "^6.2.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jsdom": "^26.1.0",
    "tslib": "^2.7.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.33.1",
    "vitest": "^4.0.8"
  }
}
